# ==============================================================================
# ITTC-AI SOC Copilot Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# Never commit real credentials or .env to version control.
# ==============================================================================

# AI / Local LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Alert Ingestion Source: "mock" (default, offline-safe) or "wazuh" (live indexer)
ALERT_SOURCE=mock

# Wazuh Indexer / OpenSearch Connection (Port 9200)
WAZUH_INDEXER_URL=https://192.168.0.106:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=your_wazuh_indexer_password
WAZUH_INDEXER_INDEX=wazuh-alerts-4.x-*
WAZUH_INDEXER_LIMIT=100
WAZUH_INDEXER_VERIFY_TLS=false

# Active Response Subsystem Configuration
# Mode: "simulated" (default, zero disruption dry-run) or "live_wazuh"
ACTIVE_RESPONSE_MODE=simulated

# Safety Switch: Keep false until live execution is explicitly validated and permitted
ACTIVE_RESPONSE_ENABLED=false

# Wazuh Manager API for Active Response Dispatch (Port 55000)
WAZUH_MANAGER_URL=https://192.168.0.106:55000
WAZUH_MANAGER_USER=wazuh-wui
WAZUH_MANAGER_PASSWORD=your_wazuh_manager_password

# Threat Intelligence (Optional: if unset, uses built-in offline mock provider)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
